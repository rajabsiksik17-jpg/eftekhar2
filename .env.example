# ============================================================
# Eftekar Medical & Therapeutic Clinics - Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any real secret to Git.
# ============================================================

# --- Supabase -------------------------------------------------
# Project Settings -> API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API (anon / publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API (service_role key - SERVER ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (optional direct connection) -------------------
# Connection string from Project Settings -> Database
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# --- Application ---------------------------------------------
NEXT_PUBLIC_SITE_URL=https://eftekar-services.com
# Used to protect the initial OTP-protected login route (any strong secret)
ADMIN_SECRET=a-long-random-secret-string

# --- Email / SMTP (outbound) ---------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=user@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Eftekar Clinics <info@eftekhar-services.com>"
SMTP_ENCRYPTION=TLS

# --- IMAP (inbound) ------------------------------------------
IMAP_HOST=imap.your-provider.com
IMAP_PORT=993
IMAP_USERNAME=user@your-domain.com
IMAP_PASSWORD=your-imap-password
IMAP_ENCRYPTION=SSL

# --- Google Analytics 4 --------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# --- Google Search Console (OAuth service account / access) --
# These are only used when connecting the Search Console integration.
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://eftekar-services.com
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
